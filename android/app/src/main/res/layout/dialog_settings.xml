<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="この端末の名前"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/deviceNameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="例：POCO F6 Pro"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/saveDeviceBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="鳴動"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/soundBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 音：ON" />

        <Button
            android:id="@+id/trackBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 曲：なし（ビープ音）" />

        <TextView
            android:id="@+id/trackHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ntpBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕐 時刻サーバー：ntp.nict.jp" />

        <Button
            android:id="@+id/syncTimeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="時刻を同期（全端末）" />

        <TextView
            android:id="@+id/timeSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="バイブレーションは音の設定に関わらず鳴動時に作動します。画面ON維持はAndroidでは不要です（アラームが自動で画面を点灯させます）。"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="確実に鳴らすための許可"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/exactBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正確なアラーム：確認中" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="電池の最適化から除外する" />

        <Button
            android:id="@+id/autostartBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自動起動・バックグラウンド許可（メーカー設定）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="端末によっては、メーカーの省電力設定で止められて鳴らないことがあります。上のボタンから設定画面を開き、「同期アラーム」について次を確認してください。&#10;・Xiaomi/HyperOS等：バッテリー使用量→「バックグラウンドアクティビティを許可」と「自動起動を許可」をON。または消費電力詳細→起動設定で「自動的に管理」をOFF、「自動起動」「バックグラウンドで実行」をON&#10;・OPPO等：電源→バッテリーセーバー→「制限なし」&#10;・Samsung等：アプリのバッテリー使用量→「バックグラウンドでの使用を許可」をON"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="接続中の端末"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/devicesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="アカウント・Firebase"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Firebase設定はアプリに組み込まれています（プロジェクト：sync-alerm）。PWA版の「貼り直し」に相当する操作はAndroid版にはありません。"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ログアウト" />
    </LinearLayout>
</ScrollView>
